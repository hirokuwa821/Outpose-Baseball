# RevenueCat SDK Configuration (Sandbox / Shipaton Demo Template)
# Copy this file to .env and replace placeholders with your actual RevenueCat credentials.

# RevenueCat Public API Key (Sandbox / Production)
REVENUECAT_API_KEY=your_revenuecat_api_key_here

# App User ID for identifying customer in RevenueCat
REVENUECAT_APP_USER_ID=your_app_user_id_here

# Entitlement Identifier configured in RevenueCat Dashboard
REVENUECAT_ENTITLEMENT_ID=pro_access

# Environment Mode: sandbox or production
REVENUECAT_ENVIRONMENT=sandbox

